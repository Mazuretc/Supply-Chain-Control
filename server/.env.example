# Copy to server/.env and replace every angle-bracketed value during deployment.
# This file intentionally contains no usable credentials.
DATABASE_URL=postgresql://lovarus_app:<DATABASE_PASSWORD>@127.0.0.1:5432/lovarus
PORT=3000
NODE_ENV=production
# Use loopback only when IIS is the same-host reverse proxy.
TRUST_PROXY=loopback
SESSION_SECRET=<GENERATE_AT_LEAST_32_RANDOM_CHARACTERS>
CSRF_SECRET=<GENERATE_A_DIFFERENT_32_CHARACTER_SECRET>
SESSION_TTL_SECONDS=28800
ADMIN_USERNAME=admin
ADMIN_PASSWORD=<SET_ON_FIRST_DEPLOYMENT>
# Base64 encoding of exactly 32 cryptographically random bytes.
IMAP_CREDENTIALS_KEY=<GENERATE_32_RANDOM_BYTES_AS_BASE64>
GPT_BASE_URL=https://gpt.internal.example/v1
GPT_API_KEY=<SET_CORPORATE_GPT_API_KEY>
GPT_MODEL=<SET_CORPORATE_GPT_MODEL>
EXTRACTION_MIN_CONFIDENCE=0.75
MAIL_POLL_INTERVAL_SECONDS=60
RETENTION_DAYS=90
