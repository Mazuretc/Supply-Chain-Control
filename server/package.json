    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/pg": "^8.21.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.4.2",
    "prisma": "^7.9.1",
